# LibSpace Backend Environment Configuration
# Copy this file to .env and update values as needed

# Project Settings
PROJECT_NAME="LibSpace API"
VERSION="1.0.0"

# API Settings
API_V1_STR="/api/v1"

# CORS Origins (comma-separated)
# Update with your Next.js frontend URL
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://192.168.1.100:3000

# Camera Settings
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=15
CAMERA_ROTATION=0  # 0, 90, 180, 270

# YOLO Model Settings
MODEL_PATH=models/yolov8n.pt
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45

# Detection Settings
DETECTION_INTERVAL=2.0  # seconds between detections
TARGET_CLASSES=["chair","person"]  # YOLO classes to detect
DETECT_CHAIRS=true  # Enable chair/seat detection
DETECT_PERSONS=true  # Enable person detection

# Chair-specific detection settings
CHAIR_CONFIDENCE_THRESHOLD=0.4  # Confidence threshold for chair detection
PERSON_CONFIDENCE_THRESHOLD=0.5  # Confidence threshold for person detection
OCCUPANCY_IOU_THRESHOLD=0.3  # Minimum overlap to consider a chair occupied

# Seat Configuration (DEPRECATED - seats are now detected dynamically)
TOTAL_SEATS=50  # This value is now ignored; seats are detected automatically
# SEAT_ZONES is configured in config.py

# Storage
SAVE_DETECTIONS=true
DETECTION_SAVE_PATH=data/detections
